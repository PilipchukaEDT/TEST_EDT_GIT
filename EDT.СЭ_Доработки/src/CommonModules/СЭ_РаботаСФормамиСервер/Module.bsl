	 
Процедура СЭ_СоздатьРеквизитыСерияИНомерПоСерииВкадровыхДокументах(Элементы, ЭлементГруппа, Источник) Экспорт
	
	ВидимостьПолей = Ложь; 
	
	ИмяМетаданные = Метаданные.НайтиПоТипу(ТипЗнч(Источник)).ПолноеИмя();	
	ВидимостьПолей = СЭ_ОбщегоНазначенияВызовСервераПривилегированный.ПрисутствиеДокументаВСправочникеСерийныеКадровыеДокументы(ИмяМетаданные);
	
	Если Элементы.Найти("СЭ_НомерПоСерии") = Неопределено Тогда
		
		НовыйЭлемент = Элементы.Вставить("СЭ_НомерПоСерии", Тип("ПолеФормы"), Элементы[ЭлементГруппа]);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.СЭ_НомерПоСерии"; 
        НовыйЭлемент.Заголовок = "№ по серии";
		//СЭ Ульяна 0016481
		//НовыйЭлемент.ТолькоПросмотр = Истина;
		//СЭ Ульяна 0016481
		НовыйЭлемент.Видимость = ВидимостьПолей; 
		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Истина;
		НовыйЭлемент.Ширина = 5;
		
	КонецЕсли;

	Если Элементы.Найти("СЭ_Серия") = Неопределено Тогда
		
		НовыйЭлемент = Элементы.Вставить("СЭ_Серия", Тип("ПолеФормы"), Элементы[ЭлементГруппа]);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.СЭ_Серия";
		НовыйЭлемент.ТолькоПросмотр = Истина;
		НовыйЭлемент.Видимость = ВидимостьПолей;
		НовыйЭлемент.Заголовок = "Серия";
		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Истина;
		НовыйЭлемент.Ширина = 2; 
		
	КонецЕсли;
	
	
КонецПроцедуры 

