Процедура СЭ_СоздатьЭлементыФормы()

	//СЭ Ульяна 0016487
		
	Элементы.Код.Видимость          = Ложь;
	Элементы.Наименование.Видимость = Ложь;
	
	нЭлемент = Элементы.Добавить("СЭ_PartNumber", Тип("ПолеФормы"), Элементы.ГруппаШапка); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_PartNumber";
		
	нЭлемент = Элементы.Добавить("СЭ_Баркод", Тип("ПолеФормы"), Элементы.ГруппаШапка); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_Баркод";
	
	нЭлемент = Элементы.Вставить("СЭ_Наименование", Тип("ПолеФормы"), Элементы.ГруппаНаименование, Элементы.Наименование); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_Наименование";
    нЭлемент.УстановитьДействие("ПриИзменении", "СЭ_НаименованиеПриИзменении");

	нЭлемент = Элементы.Добавить("СЭ_НаименованиеАнгл", Тип("ПолеФормы"), Элементы.ГруппаНаименование); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_НаименованиеАнгл";

	Если Пользователи.РолиДоступны("СЭ_ПросмотрВсехКарточекНоменклатуры", Пользователи.ТекущийПользователь()) тогда
		нЭлемент = Элементы.Добавить("СЭ_РазрешеноИспользование", Тип("ПолеФормы"), Элементы.СворачиваемаяГруппаОсновныеПараметрыУчета); 
		нЭлемент.Вид = ВидПоляФормы.ПолеФлажка; 
		нЭлемент.ПутьКДанным = "Объект.СЭ_РазрешеноИспользование";	
