  <attributes>
    <name>СписокНоменклатура</name>
    <title>
      <key>ru</key>
      <value>Список номенклатура</value>
    </title>
    <title>
      <key>en</key>
      <value>List products</value>
    </title>
    <id>1000001</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.Артикул</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.ВидНоменклатуры</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.Наименование</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.Наличие</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.Резерв</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокНоменклатура.Родитель</segments>
    </notDefaultUseAlwaysAttributes>
