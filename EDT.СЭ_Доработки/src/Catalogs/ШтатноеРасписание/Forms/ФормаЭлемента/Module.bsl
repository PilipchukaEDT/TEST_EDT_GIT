&НаКлиенте
Процедура СЭ_ПодборЗУН(Команда)
	
	ОткрытьФорму("Справочник.СЭ_ЗУН.ФормаВыбора", СЭ_ПолучитьПараметрыФормыВыбора(), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция СЭ_ПолучитьПараметрыФормыВыбора()

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
    ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.ГруппыИЭлементы);

    Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура СЭ_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.СЭ_ЗУН.ФормаВыбора" Тогда
		СЭ_ОбщаяПроцедураОбработкиПодбора(ВыбранноеЗначение);
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ШтатноеРасписание.ФормаВыбора"
		ИЛИ ИсточникВыбора.ИмяФормы = "Справочник.ШтатноеРасписание.Форма.ФормаСписка"
		Тогда
		Если ВыбранноеЗначение <> Неопределено Тогда
			СЭ_КопироватьПоДаннымДругогоНаСервере(ВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура СЭ_ОбщаяПроцедураОбработкиПодбора(ВыбранноеЗначение)
	
	ИмяТЧ = "СЭ_СвязанныеЗУН"; 
	ИмяРеквизита = "ЗУН";
	
	МассивГрупп 	= Новый Массив;
	МассивЭлементов = Новый Массив;
	Для каждого СтрокаВыбора Из ВыбранноеЗначение Цикл
		Если СтрокаВыбора.ЭтоГруппа Тогда
			МассивГрупп.Добавить(СтрокаВыбора);	
		Иначе
			МассивЭлементов.Добавить(СтрокаВыбора);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Справочник.Ссылка
		|ПОМЕСТИТЬ СписокЭлементов
		|ИЗ
		|	Справочник.СЭ_ЗУН КАК Справочник
		|ГДЕ
		|	Справочник.Ссылка В(&МассивЭлементов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокЭлементов.Ссылка КАК Ссылка
		|ИЗ
		|	СписокЭлементов КАК СписокЭлементов
		|
		|СГРУППИРОВАТЬ ПО
		|	СписокЭлементов.Ссылка";
		
	//На случай если когда нибудь будет принято решение сделать справочник иерархическим
	Если МассивГрупп.Количество() > 0 Тогда
		
		ТекстПоискаГрупп = 
		"ВЫБРАТЬ	
		|	Справочник.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ СписокЭлементов
		|ИЗ
		|	Справочник.СЭ_ЗУН КАК Справочник
		|ГДЕ
		|	Справочник.Родитель В ИЕРАРХИИ (&МассивГрупп)
		|	И Справочник.ЭтоГруппа = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПОМЕСТИТЬ СписокЭлементов", "");
		Запрос.Текст = ТекстПоискаГрупп + Запрос.Текст;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивЭлементов", МассивЭлементов);
	Запрос.УстановитьПараметр("МассивГрупп", МассивГрупп);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура(ИмяРеквизита, Выборка.Ссылка);
		СтрокиПоиска = ЭтаФорма[ИмяТЧ].НайтиСтроки(Отбор);
		Если СтрокиПоиска.Количество() = 0 Тогда
			НовСтрока = ЭтаФорма[ИмяТЧ].Добавить();
			НовСтрока[ИмяРеквизита]  = Выборка.Ссылка;
			НовСтрока.РучнойВВод	= Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	

КонецПроцедуры

&НаКлиенте
Процедура СЭ_КопироватьПоДаннымДругойШП(Команда)

	СЭ_КопироватьПоДаннымДругогоНаКлиенте("СЭ_СвязанныеЗУН");

КонецПроцедуры

&НаКлиенте
Процедура СЭ_КопироватьПоДаннымДругогоНаКлиенте(ИмяТЧ)
	
	Если ЭтаФорма[ИмяТЧ].Количество() > 0 Тогда
		Оп = Новый ОписаниеОповещения("СЭ_КопироватьПоДаннымДругогоНаКлиентеЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оп, "Данные в таблице будут перезаполнены. Продолжить?", РежимДиалогаВопрос.ДаНет);
	Иначе
		СЭ_КопироватьПоДаннымДругогоНаКлиентеВыполнение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СЭ_КопироватьПоДаннымДругогоНаКлиентеЗавершение(Результат, ДопПараметры)  Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		СЭ_КопироватьПоДаннымДругогоНаКлиентеВыполнение();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СЭ_КопироватьПоДаннымДругогоНаКлиентеВыполнение()
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму("Справочник.ШтатноеРасписание.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура СЭ_КопироватьПоДаннымДругогоНаСервере(ВыбранноеЗначение)

	ИмяТЧ = "СЭ_СвязанныеЗУН";
	
	Запрос = Новый Запрос();
	Запрос.Текст = СЭ_ПолучитьЗапросКРегиструДляТЧ();
	Запрос.УстановитьПараметр("ШтатнаяПозиция", ВыбранноеЗначение);
	
	ЭтаФорма[ИмяТЧ].Загрузить(Запрос.Выполнить().Выгрузить());
	
	Модифицированность = Истина;
	
КонецПроцедуры

