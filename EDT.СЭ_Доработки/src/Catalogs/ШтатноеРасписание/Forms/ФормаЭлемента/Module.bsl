&НаСервере
Процедура СЭ_СохранитьПланРазвития(ТекущийОбъект, Отказ)
	
	ИмяТЧ = "СЭ_ПланРазвития"; 
	ИмяРегистра = "СЭ_ПланРазвития";
	
	НачатьТранзакцию();
	
	Попытка
			
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей(); 	
		НаборЗаписей.Отбор.ШтатнаяПозиция.Установить(ТекущийОбъект.Ссылка); 

		Для Каждого СтрокаТЧ Из ЭтаФорма[ИмяТЧ] Цикл  		
			НоваяЗапись = НаборЗаписей.Добавить();  		
			НоваяЗапись.ШтатнаяПозиция = ТекущийОбъект.Ссылка; 
			ЗаполнитьЗначенияСвойств(НоваяЗапись,СтрокаТЧ);
			
			СтрокаТЧ.РучнойВВод = Ложь;
		КонецЦикла; 
		
		НаборЗаписей.Записать();	
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("При записи данных из таблицы ""%1"" произошла ошибка: %2", Элементы[ИмяТЧ].Заголовок, ОписаниеОшибки());
		Сообщение.Сообщить();  
		
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
КонецПроцедуры
