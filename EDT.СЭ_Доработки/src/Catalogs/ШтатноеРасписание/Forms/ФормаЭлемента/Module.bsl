&НаКлиенте
Процедура СЭ_СвязанныеЗУНПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.Порядок = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СЭ_СвязанныеЗУНВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, Элемент.ТекущиеДанные.ЗУН);
КонецПроцедуры

&НаСервере
Процедура СЭ_СоздатьРеквизитыТаблицы(ТаблицаКолонок, ИмяТЧНаФорме)

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяТЧНаФорме, Новый ОписаниеТипов("ТаблицаЗначений")));
	Для каждого Колонка из ТаблицаКолонок.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ИмяТЧНаФорме));
	КонецЦикла;
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты); 	

КонецПроцедуры

&НаСервере
Процедура СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТаблицыНаФорме, ИмяРеквизитаЗУН, ЗаголовокКолонки)
	
	НоваяТаблица = Элементы[ИмяТаблицыНаФорме];
	
	НоваяКолонка = Элементы.Добавить(СтрШаблон("%1_ЗУН_%2", ИмяТаблицыНаФорме, ИмяРеквизитаЗУН), Тип("ПолеФормы"), НоваяТаблица);
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ПутьКДанным = СтрШаблон("%1.ЗУН.%2", ИмяТаблицыНаФорме, ИмяРеквизитаЗУН);
	НоваяКолонка.Заголовок = ЗаголовокКолонки;
	НоваяКолонка.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СЭ_ОбновитьДанныеТаблицНаСервере()
	
	//СЭ_СвязанныеЗУН +++
	ИмяТЧ = "СЭ_СвязанныеЗУН";
	
	//СЭ+ Евгений [17199] было принято решение скрыть вкладку мол больше не нужна, но не удалять вдруг снова понадобится
	Если Элементы[ИмяТЧ].Видимость Тогда
	//СЭ- Евгений [17199] было принято решение скрыть вкладку мол больше не нужна, но не удалять вдруг снова понадобится
			
		ТЗ_ДанныхНаФорме = ЭтаФорма[ИмяТЧ].Выгрузить();
		
		Запрос = Новый Запрос();
		Запрос.Текст = СЭ_ПолучитьЗапросКРегиструДляТЧ();
		Запрос.УстановитьПараметр("ШтатнаяПозиция", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		ЭтаФорма[ИмяТЧ].Загрузить(РезультатЗапроса);	
		
		//Если были добавлены позиции руками то их не теряем
		Для каждого СтрокаТЗ Из ТЗ_ДанныхНаФорме Цикл
			Если СтрокаТЗ.РучнойВВод Тогда
				
				ИмяКлючевогоПоля = "ЗУН";
				
				//Если мы добавили позиции руками, записали а потом обновляем, то то что было ручным перестало быть ручным
				Отбор = Новый Структура;
				Отбор.Вставить(ИмяКлючевогоПоля, СтрокаТЗ[ИмяКлючевогоПоля]); 
				
				СтрокиПоиска = ЭтаФорма[ИмяТЧ].НайтиСтроки(Отбор);
				Если СтрокиПоиска.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
				
				НовСтрока = ЭтаФорма[ИмяТЧ].Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаТЗ);
				
			КонецЕсли;
		КонецЦикла;
		
		ЭтаФорма[ИмяТЧ].Сортировать("Порядок ВОЗР");
		
	КонецЕсли;
	//СЭ_СвязанныеЗУН ---
	
	//СЭ+ Евгений [17113] ПланРазвития +++
	ИмяТЧ = "СЭ_ПланРазвития";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СЭ_ПланРазвития.КвалификацияЗУН КАК КвалификацияЗУН
		|ИЗ
		|	РегистрСведений.СЭ_ПланРазвития КАК СЭ_ПланРазвития
		|ГДЕ
		|	СЭ_ПланРазвития.ШтатнаяПозиция = &ШтатнаяПозиция
		|
		|УПОРЯДОЧИТЬ ПО
		|	СЭ_ПланРазвития.КвалификацияЗУН.НомерДляСортировки";
	
	Запрос.УстановитьПараметр("ШтатнаяПозиция", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	ЭтаФорма[ИмяТЧ].Загрузить(РезультатЗапроса);
	//СЭ- Евгений [17113] ПланРазвития ---
	
КонецПроцедуры

&НаСервере
Функция СЭ_ПолучитьЗапросКРегиструДляТЧ()
	
	ТекстЗапрос = "ВЫБРАТЬ
	              |	Регистр.ЗУН КАК ЗУН,
	              |	Регистр.Порядок КАК Порядок,
	              |	Регистр.УровеньСотрудника КАК УровеньСотрудника
	              |ИЗ
	              |	РегистрСведений.СЭ_СвязанныеСКвалификациейЗУН КАК Регистр
	              |ГДЕ
	              |	Регистр.КвалификацияЗУН.СоответствиеШтатныхПозиций.ШтатнаяПозиция = &ШтатнаяПозиция
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Регистр.Порядок";
	
		
	Возврат ТекстЗапрос;
	
КонецФункции 

