
&НаСервере
&После("ПриСозданииНаСервере")
Процедура СЭ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СЭ_СоздатьЭлементыФормы();
	СЭ_ОбновитьДанныеТаблицНаСервере();
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		
		РаботаСЗУН = РольДоступна("СЭ_РаботаСПланомПовышенияКвалификацииВШтатномРасписании");
		
		//Изменилась логика, теперь если роль есть то видна тока наша вкладка, если роли нет то видны вообще все
		Если РаботаСЗУН Тогда
			
			Элементы.ОплатаТрудаСтраница.Видимость 		= НЕ РаботаСЗУН;
			Элементы.ДополнительноСтраница.Видимость 	= НЕ РаботаСЗУН;
			Элементы.СпециальностиСтраница.Видимость 	= НЕ РаботаСЗУН;
			Элементы.ЛьготыСтраница.Видимость 			= НЕ РаботаСЗУН;
			Элементы.КадровыйРезервСтраница.Видимость 	= НЕ РаботаСЗУН;
			
			Элементы.СЭ_СтраницаСвязанныеЗУН.Видимость 	= РаботаСЗУН;
			Элементы.СЭ_СтраницаПланРазвития.Видимость 	= РаботаСЗУН;
			
		Иначе
			//Видит все вкладки	
		КонецЕсли;
		
		//СЭ+ Евгений [16766] не показываем не нужную инфу
		СЭ_СкрытьКадровуюИнформациюЗУН = РольДоступна("СЭ_СкрытьКадровуюИнформациюЗУН");
		
		Элементы.УтвердившийРегистраторНадпись.Видимость 	= НЕ СЭ_СкрытьКадровуюИнформациюЗУН;	
		Элементы.ЗакрывшийРегистраторНадпись.Видимость 		= НЕ СЭ_СкрытьКадровуюИнформациюЗУН;
		//СЭ- Евгений [16766]
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
&После("ПриЧтенииНаСервере")
Процедура СЭ_ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Элементы.Найти("СЭ_СвязанныеЗУН") <> Неопределено Тогда
		СЭ_ОбновитьДанныеТаблицНаСервере();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СЭ_СоздатьЭлементыФормы()

	//СЭ+ Евгений [16177] создаём динамически заполняемую таблицу формы, похожую как в карточке ЗУН
	
	//СозданиеТЧ++++
	ИмяТЧ = "СЭ_СвязанныеЗУН";
	
	ТаблицаКолонок = Новый ТаблицаЗначений;
	ТаблицаКолонок.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3, 0)), "НПП");
	ТаблицаКолонок.Колонки.Добавить("УровеньСотрудника", Новый ОписаниеТипов("СправочникСсылка.СЭ_УровниСотрудников"), "Уровень сотрудника");
	ТаблицаКолонок.Колонки.Добавить("ЗУН", Новый ОписаниеТипов("СправочникСсылка.СЭ_ЗУН"), "ЗУН");
	ТаблицаКолонок.Колонки.Добавить("РучнойВвод", Новый ОписаниеТипов("Булево"));
	
	СЭ_СоздатьРеквизитыТаблицы(ТаблицаКолонок, ИмяТЧ);
	
	НовСтраница = Элементы.Добавить("СЭ_СтраницаСвязанныеЗУН", Тип("ГруппаФормы"), Элементы.СтраницыФормы);
	НовСтраница.Вид = ВидГруппыФормы.Страница;
	НовСтраница.Заголовок = "План повышения квалификации";
		
	НоваяТаблица = Элементы.Добавить(ИмяТЧ, Тип("ТаблицаФормы"), Элементы.СЭ_СтраницаСвязанныеЗУН);
	НоваяТаблица.ПутьКДанным = ИмяТЧ;
	НоваяТаблица.Отображение = ОтображениеТаблицы.Список;
	НоваяТаблица.Заголовок = "План повышения квалификации";
	НоваяТаблица.УстановитьДействие("ПриНачалеРедактирования", "СЭ_СвязанныеЗУНПриНачалеРедактирования");
	
	//СЭ+ Евгений [17199] было принято решение скрыть вкладку мол больше не нужна, но не удалять вдруг снова понадобится
	НовСтраница.Видимость = Ложь;
	НоваяТаблица.Видимость = Ложь;
	//СЭ- Евгений [17199]

	//СЭ+ Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН
	НоваяТаблица.ИзменятьСоставСтрок = Ложь;
	НоваяТаблица.УстановитьДействие("Выбор", "СЭ_СвязанныеЗУНВыбор");
	//СЭ- Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН

	Для каждого Колонка из ТаблицаКолонок.Колонки Цикл
		
		Если Колонка.Имя = "РучнойВвод" Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяКолонка = Элементы.Добавить(СтрШаблон("%1_%2", ИмяТЧ, Колонка.Имя), Тип("ПолеФормы"), НоваяТаблица);
		НоваяКолонка.Вид 			= ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным 	= СтрШаблон("%1.%2", ИмяТЧ, Колонка.Имя);
		НоваяКолонка.Заголовок 		= Колонка.Заголовок;
		
		//СЭ+ Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН
		//Если Колонка.Имя = "Порядок" Тогда
		//	НоваяКолонка.ТолькоПросмотр = Истина;
		//Иначе
		//	НоваяКолонка.КартинкаШапки 	= БиблиотекаКартинок.Изменить;
		//КонецЕсли;
		НоваяКолонка.ТолькоПросмотр = Истина; 
		//СЭ- Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН
		
	КонецЦикла;
	
	//Производные колонки от ЗУН
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "УчебныеМатериалы", "Учебные материалы");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "ОбластьЗУН", "Область ЗУН");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "ТипЗУН", "Тип ЗУН");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "СпособПолученияЗУН", "Способ получения ЗУН");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "УровеньИзученияЗУН", "Уровень изучения ЗУН");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "НеОбязательное", "Не обязательное");
	СЭ_ДобавитьКолонкуВТЧПоЗУН(ИмяТЧ, "НеАктуально", "Не актуально");
	//СозданиеТЧ----
	                            
	//Команды++++
	//Группа сортировки
	НоваяГруппа = Элементы.Добавить(СтрШаблон("%1_КомандыСортировать", ИмяТЧ), Тип("ГруппаФормы"), НоваяТаблица.КоманднаяПанель);
	НоваяГруппа.Вид = ВидГруппыФормы.ГруппаКнопок;
	НоваяГруппа.Отображение = ОтображениеГруппыКнопок.Компактное;
	
	НоваяКнопка = Элементы.Добавить(СтрШаблон("%1СортироватьСписокПоВозрастанию", ИмяТЧ), Тип("КнопкаФормы"), НоваяГруппа);
	//НоваяКнопка.ИмяКоманды = СтрШаблон("%1СортироватьСписокПоВозрастанию", ИмяТЧ); 
    НоваяКнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанелиИВДополнительномПодменю;
	
	НоваяКнопка = Элементы.Добавить(СтрШаблон("%1СортироватьСписокПоУбыванию", ИмяТЧ), Тип("КнопкаФормы"), НоваяГруппа);
	//НоваяКнопка.ИмяКоманды = СтрШаблон("%1СортироватьСписокПоУбыванию", ИмяТЧ);   
	НоваяКнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанелиИВДополнительномПодменю;
	
	//ОбновитьДанныеТЧ
	НоваяКоманда = ЭтаФорма.Команды.Добавить("СЭ_ОбновитьДанныеТЧ");
	НоваяКоманда.Действие = "СЭ_ОбновитьДанныеТЧ";
	//НоваяКоманда.Подсказка = "Обновить данные ТЧ по данным регистра, добавленные новые вручную строки не удаляются, но положение может изменится";
	НоваяКоманда.Подсказка = "Обновить";

	НовыйЭлемент = Элементы.Добавить("СЭ_ОбновитьДанныеТЧ", Тип("КнопкаФормы"), НоваяТаблица.КоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = "СЭ_ОбновитьДанныеТЧ";
	НовыйЭлемент.Заголовок  = "Обновить";
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	НовыйЭлемент.Картинка = БиблиотекаКартинок.Обновить;
	
	//Подбор
	НоваяКоманда = ЭтаФорма.Команды.Добавить("СЭ_ПодборЗУН");
	НоваяКоманда.Действие = "СЭ_ПодборЗУН";
	
	НовыйЭлемент = Элементы.Добавить("СЭ_ПодборЗУН", Тип("КнопкаФормы"), НоваяТаблица.КоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = "СЭ_ПодборЗУН";
	НовыйЭлемент.Заголовок  = "Подбор";
	
	//Копировать по данным другой ШП
	НоваяКоманда = ЭтаФорма.Команды.Добавить("СЭ_КопироватьПоДаннымДругойШП");
	НоваяКоманда.Действие = "СЭ_КопироватьПоДаннымДругойШП";
	
	НовыйЭлемент = Элементы.Добавить("СЭ_КопироватьПоДаннымДругойШП", Тип("КнопкаФормы"), НоваяТаблица.КоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = "СЭ_КопироватьПоДаннымДругойШП";
	НовыйЭлемент.Заголовок  = "Скопировать из";
	//Команды----
	
	//СЭ+ Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН
	Элементы.СЭ_ПодборЗУН.Видимость = Ложь;
	Элементы.СЭ_КопироватьПоДаннымДругойШП.Видимость = Ложь;
	//СЭ- Евгений новая вводная, все колонки Только просмотр и заполнять будут только из карточек ЗУН
	
	//СЭ- Евгений [16177]
	
	//СЭ+ Евгений [17113]
	ИмяТЧ = "СЭ_ПланРазвития";
	
	ТаблицаКолонок = Новый ТаблицаЗначений;
	ТаблицаКолонок.Колонки.Добавить("КвалификацияЗУН", Новый ОписаниеТипов("СправочникСсылка.СЭ_КвалификацииЗУН"), "Квалификации ЗУН");
	ТаблицаКолонок.Колонки.Добавить("РучнойВвод", Новый ОписаниеТипов("Булево"));
	
	СЭ_СоздатьРеквизитыТаблицы(ТаблицаКолонок, ИмяТЧ);
	
	НовСтраница = Элементы.Добавить("СЭ_СтраницаПланРазвития", Тип("ГруппаФормы"), Элементы.СтраницыФормы);
	НовСтраница.Вид = ВидГруппыФормы.Страница;
	НовСтраница.Заголовок = "План развития";
	
	НоваяТаблица = Элементы.Добавить(ИмяТЧ, Тип("ТаблицаФормы"), НовСтраница);
	НоваяТаблица.ПутьКДанным = ИмяТЧ;
	НоваяТаблица.Отображение = ОтображениеТаблицы.Список;
	НоваяТаблица.Заголовок = "План развития";
    НоваяТаблица.УстановитьДействие("ПриНачалеРедактирования", "СЭ_ПланРазвитияНачалеРедактирования");

	Для каждого Колонка из ТаблицаКолонок.Колонки Цикл
		
		Если Колонка.Имя = "РучнойВвод" Тогда
			Продолжить;
		КонецЕсли;
	
		НоваяКолонка = Элементы.Добавить(СтрШаблон("%1_%2", ИмяТЧ, Колонка.Имя), Тип("ПолеФормы"), НоваяТаблица);
		НоваяКолонка.Вид 			= ВидПоляФормы.ПолеВвода;
		НоваяКолонка.ПутьКДанным 	= СтрШаблон("%1.%2", ИмяТЧ, Колонка.Имя);
		НоваяКолонка.Заголовок 		= Колонка.Заголовок;
				
	КонецЦикла;
	//СозданиеТЧ----
	//СЭ- Евгений [17113]
	
КонецПроцедуры

