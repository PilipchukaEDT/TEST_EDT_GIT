&НаКлиенте
Процедура СЭ_СуммаДоговораЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оп = Новый ОписаниеОповещения("СЭ_ВыборДокументаДляЗаполненияСуммы", ЭтотОбъект);
	
	ПараметрыФормы = СЭ_ПолучитьПараметрыФормыВыбора();
	 		
	Если Результат = "Интерес клиента" Тогда
		
		ЗначениеОтбора = Новый Структура();
		ЗначениеОтбора.Вставить("Партнер", Объект.Партнер);
		ЗначениеОтбора.Вставить("ПометкаНаУдаление", Ложь);
		
		ПараметрыФормы.Вставить("Отбор", ЗначениеОтбора);
		    
		ОткрытьФорму("Документ.CRM_Интерес.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, Оп);	
		
	ИначеЕсли Результат = "Коммерческое предложение клиенту" Тогда
		
		ЗначениеОтбора = Новый Структура();
		ЗначениеОтбора.Вставить("Клиент", Объект.Партнер);
		ЗначениеОтбора.Вставить("Проведен", Истина);
		
		ПараметрыФормы.Вставить("Отбор", ЗначениеОтбора);
		
		ОткрытьФорму("Документ.КоммерческоеПредложениеКлиенту.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, Оп);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СЭ_ПолучитьПараметрыФормыВыбора()

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("РежимВыбора"		, Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		
    Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура СЭ_ВыборДокументаДляЗаполненияСуммы(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураРезультата = СЭ_ПолучитьСуммуПоДокументу(Результат);
	Объект.СЭ_Сумма_ТД 		= СтруктураРезультата.Сумма;
    Объект.СЭ_СуммаНДС_ТД 	= СтруктураРезультата.СуммаНДС;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СЭ_ПолучитьСуммуПоДокументу(ДокументСсылка)

	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Сумма", 0);
	СтруктураРезультата.Вставить("СуммаНДС", 0);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.CRM_Интерес") Тогда
		СтруктураРезультата.Сумма = ДокументСсылка.ОжидаемаяВыручка;	
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КоммерческоеПредложениеКлиенту") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СУММА(КоммерческоеПредложениеКлиентуТовары.СуммаСНДС) КАК Сумма,
			|	КоммерческоеПредложениеКлиентуТовары.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.КоммерческоеПредложениеКлиенту.Товары КАК КоммерческоеПредложениеКлиентуТовары
			|ГДЕ
			|	КоммерческоеПредложениеКлиентуТовары.Ссылка = &Ссылка
			|	И КоммерческоеПредложениеКлиентуТовары.CRM_Утвержден = ИСТИНА
			|
			|СГРУППИРОВАТЬ ПО
			|	КоммерческоеПредложениеКлиентуТовары.Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			СтруктураРезультата.Сумма = Выборка.Сумма;
		КонецЦикла;
			
	КонецЕсли;
	
	СтруктураРезультата.СуммаНДС = СЭ_РассчитатьСуммаНДС(СтруктураРезультата.Сумма);
		
	Возврат СтруктураРезультата;

КонецФункции 

&НаСервереБезКонтекста
Функция СЭ_РассчитатьСуммаНДС(СуммаДляРасчета)
	
	СуммаНДС = 0;
	
	Если СуммаДляРасчета <> 0 Тогда
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СтавкиНДС.Ссылка КАК Ссылка,
			|	СтавкиНДС.Ставка КАК Ставка
			|ИЗ
			|	Справочник.СтавкиНДС КАК СтавкиНДС
			|ГДЕ
			|	СтавкиНДС.Основная = ИСТИНА
			|	И СтавкиНДС.ПометкаУдаления = ЛОЖЬ";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
				
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СтавкаНДС = Выборка.Ставка;
			КонецЦикла;
			
			СуммаНДС = СуммаДляРасчета * СтавкаНДС / (100 + СтавкаНДС);
			
		КонецЕсли;
		
	Конецесли;
	
    Возврат СуммаНДС;
	
КонецФункции 

&НаКлиенте
Процедура СЭ_Сумма_ТДПриИзменении(Элемент)

	Объект.СЭ_СуммаНДС_ТД = СЭ_РассчитатьСуммаНДС(Объект.СЭ_Сумма_ТД);	

КонецПроцедуры

