
&НаСервере
&После("ПриСозданииНаСервере")
Процедура СЭ_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СЭ_СоздатьРеквизитыФормы();
	СЭ_СоздатьЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура СЭ_ПриОткрытии(Отказ)
	
	//СЭ+ Евгений [16920]
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_ПриложенияКДоговору", Истина);
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_ВидыДействий");
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_Тендер");

	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_ЗаданияИнженеру");
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_АктыВыполненныхРабот");
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_ДефектныеАкты");
	
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_АктыЕРП", Истина);
	СЭ_ОбщегоНазначенияКлиент.ЗаполнитьКоманднуюПанельТаблицыСтандартнымиКнопками(ЭтаФорма, "СЭ_ЗапланированныеДействия", Истина);
	//СЭ- Евгений [16920]
	
КонецПроцедуры

&НаКлиенте
&После("ОбработкаОповещения")
Процедура СЭ_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	//СЭ+ Евгений [16920]
	Если ИмяСобытия = "Запись_РегистрСведенийСостоянияОригиналовПервичныхДокументов" Тогда
		Объект.СЭ_ДатаВозвратаДоговора = СЭ_ПолучитьДатуВозвратаИзРегистраСостоянияОригиналов(Объект.Ссылка, Объект.СЭ_ДатаВозвратаДоговора);
		Модифицированность = Истина;
	КонецЕсли;           
	//СЭ- Евгений [16920]
	
КонецПроцедуры

&НаСервере
Процедура СЭ_СоздатьРеквизитыФормы()
                
	ДинамическийСписок1 = Новый РеквизитФормы("СЭ_ОборудованиеПоПриложению", Новый ОписаниеТипов("ДинамическийСписок"));
	ДинамическийСписок2 = Новый РеквизитФормы("СЭ_ЗапланированныеДействия", Новый ОписаниеТипов("ДинамическийСписок"));
    ДинамическийСписок3 = Новый РеквизитФормы("СЭ_АктыЕРП", Новый ОписаниеТипов("ДинамическийСписок"));
    ДинамическийСписок4 = Новый РеквизитФормы("СЭ_ПриложенияКДоговору", Новый ОписаниеТипов("ДинамическийСписок"));
   
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок1);
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок2);
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок3);
    ДобавляемыеРеквизиты.Добавить(ДинамическийСписок4);

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ЗадатьЗапросДинСписка("СЭ_ОборудованиеПоПриложению");
	ЗадатьЗапросДинСписка("СЭ_ЗапланированныеДействия");
	ЗадатьЗапросДинСписка("СЭ_АктыЕРП");
	ЗадатьЗапросДинСписка("СЭ_ПриложенияКДоговору");
		
КонецПроцедуры

&НаСервере
Процедура ЗадатьЗапросДинСписка(ИмяДинСписка)
	
	РеквизитДС = ЭтаФорма[ИмяДинСписка];
	РеквизитДС.ПроизвольныйЗапрос = Истина;
	
	РеквизитУсловие = "Договор"; //если не произвольный запрос и надо сделать отбор на договор
	ТекстЗапроса	= "";        //если произвольный запрос то пишем свой текст запроса
	ОсновнаяТаблица = "";        //если произвольный запрос то можно указать основную таблицу для отображение типовых команд на создание элементов
		
	//Задаём текст запроса
	Если ИмяДинСписка = "СЭ_ОборудованиеПоПриложению" Тогда
		
		#Область ТекстЗапроса_ОборудованиеПоПриложению
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО КАК Оборудование,
		|	СЭ_ПриложенияКДоговору.СерийныйНомерОборудования КАК СерийныйНомерОборудования,
		|	СЭ_ПриложенияКДоговору.Местонахождение КАК Местонахождение,
		|	СЭ_ПриложенияКДоговору.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
		|	СЭ_ПриложенияКДоговору.ДатаОкончания КАК ДатаОкончания,
		|	СЭ_ПриложенияКДоговору.СрокГарантии КАК СрокГарантии,
		|	СЭ_ПриложенияКДоговору.ДатаПередачи КАК ДатаПередачи,
		|	СЭ_ПриложенияКДоговору.ПериодОбслуживания КАК ПериодОбслуживания,
		|	СЭ_ПриложенияКДоговору.ТТН КАК ТТН,
		|	СЭ_ПриложенияКДоговору.Валюта КАК Валюта
		|ИЗ
		|	Справочник.СЭ_ПриложенияКДоговору.ДействияНадОборудованием КАК СЭ_ПриложенияКДоговору
		|ГДЕ
		|	СЭ_ПриложенияКДоговору.Ссылка = &Ссылка";
		
		//реквизит СЭ_Оборудование в расширении СмартДеск
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НЕОПРЕДЕЛЕНО", "СЭ_ПриложенияКДоговору.СЭ_Оборудование");
		
		#КонецОбласти
		
	ИначеЕсли ИмяДинСписка = "СЭ_ЗапланированныеДействия" Тогда
		
		#Область ТекстЗапроса_ЗапланированныеДействия
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	НЕОПРЕДЕЛЕНО КАК Оборудование,
		|	СЭ_ЗапланированныеДействия.Регистратор КАК Регистратор,
		|	СЭ_ЗапланированныеДействия.ВидДействия КАК ВидДействия,
		|	СЭ_ЗапланированныеДействия.ДатаПлан КАК ДатаПлан,
		|	СЭ_ЗапланированныеДействия.ЧтоСделать КАК ЧтоСделать,
		|	СЭ_ЗапланированныеДействия.Исполнитель КАК Исполнитель,
		|	СЭ_ЗапланированныеДействия.Регистратор.СерийныйНомерОборудования КАК СерийныйНомерОборудования,
		|	СЭ_ЗапланированныеДействия.Регистратор.Местонахождения КАК Местонахождения,
		|	СЭ_ЗапланированныеДействия.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.СЭ_ЗапланированныеДействия КАК СЭ_ЗапланированныеДействия
		|ГДЕ
		|	СЭ_ЗапланированныеДействия.Клиент = &Клиент
		|
		|СГРУППИРОВАТЬ ПО
		|	СЭ_ЗапланированныеДействия.Статус,
		|	СЭ_ЗапланированныеДействия.ДатаПлан,
		|	СЭ_ЗапланированныеДействия.Исполнитель,
		|	СЭ_ЗапланированныеДействия.ЧтоСделать,
		|	СЭ_ЗапланированныеДействия.Регистратор,
		|	СЭ_ЗапланированныеДействия.ВидДействия,
		|	СЭ_ЗапланированныеДействия.Регистратор.СерийныйНомерОборудования,
		|	СЭ_ЗапланированныеДействия.Регистратор.Местонахождения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПлан";	
		
		//реквизит СЭ_Оборудование в расширении СмартДеск
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НЕОПРЕДЕЛЕНО", "СЭ_ЗапланированныеДействия.Регистратор.СЭ_Оборудование");
		
		#КонецОбласти
		
	ИначеЕсли ИмяДинСписка = "СЭ_АктыЕРП" Тогда
		
		#Область ТекстЗапроса_АктыЕРП
		
		РеквизитДС.ОсновнаяТаблица = "Документ.АктВыполненныхРабот";
		РеквизитДС.ПроизвольныйЗапрос = Ложь; // Для создания элементов нужно, чтобы это был штатный список
		
		#КонецОбласти
		
	ИначеЕсли ИмяДинСписка = "СЭ_ПриложенияКДоговору" Тогда
		
		#Область ТекстЗапроса_ПриложенияКДоговору
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	СЭ_ПриложенияКДоговору.Ссылка КАК Ссылка,
		|	0 КАК Сумма,
		|	ВЫБОР
		|		КОГДА СЭ_ПриложенияКДоговору.ДатаВозвратаПриложения <> ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ВозвратПриложения,
		|	СЭ_ПриложенияКДоговору.Владелец КАК Владелец,
		|	СЭ_ПриложенияКДоговору.Наименование КАК Наименование,
		|	СЭ_ПриложенияКДоговору.НомерПриложения КАК НомерПриложения,
		|	СЭ_ПриложенияКДоговору.ДатаПриложения КАК ДатаПриложения,
		|	СЭ_ПриложенияКДоговору.ДействуетС КАК ДействуетС,
		|	СЭ_ПриложенияКДоговору.ДействуетПо КАК ДействуетПо,
		|	СЭ_ПриложенияКДоговору.ДатаВозвратаПриложения КАК ДатаВозвратаПриложения,
		|	СЭ_ПриложенияКДоговору.СтадияПодписания КАК СтадияПодписания,
		|	СЭ_ПриложенияКДоговору.Прейскурант КАК Прейскурант,
		|	СЭ_ПриложенияКДоговору.Примечание КАК Примечание
		|ИЗ
		|	Справочник.СЭ_ПриложенияКДоговору КАК СЭ_ПриложенияКДоговору
		|ГДЕ
		|	СЭ_ПриложенияКДоговору.Владелец = &Владелец";
		
		
		ОсновнаяТаблица = "Справочник.СЭ_ПриложенияКДоговору";
		
		РеквизитДС.УстановитьОбязательноеИспользование("Владелец", Истина);

		#КонецОбласти
		
	Иначе
		
		Сообщить(СтрШаблон("Не установлены настройки для дин. списка %1", ИмяДинСписка));
		Возврат;
		
	КонецЕсли;
	
	Если РеквизитДС.ПроизвольныйЗапрос Тогда
		
		//Устанавливаем текст запроса
		РеквизитДС.ТекстЗапроса = ТекстЗапроса;
		
		//Делаем ссылку всегда "Использовать всегда"
		РеквизитДС.УстановитьОбязательноеИспользование("Ссылка", Истина);
		
		//Указываем основную таблицу если надо создавать новые элементы из дин списка
		Если НЕ ПустаяСтрока(ОсновнаяТаблица) Тогда
			РеквизитДС.ОсновнаяТаблица = ОсновнаяТаблица;
		КонецЕсли;
		
	Иначе
		
		//Типовые отборы на договор если не произвольный запрос
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РеквизитДС, РеквизитУсловие, Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		Иначе	
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РеквизитДС, "Ссылка"
																		, Неопределено
																		, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		КонецЕсли;

	КонецЕсли;
	
	//Установка параметров
	Если ИмяДинСписка = "СЭ_ОборудованиеПоПриложению" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РеквизитДС, "Ссылка", Неопределено, Истина);	
	ИначеЕсли ИмяДинСписка = "СЭ_ЗапланированныеДействия" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РеквизитДС, "Клиент", Объект.Партнер, Истина);	
	ИначеЕсли ИмяДинСписка = "СЭ_ПриложенияКДоговору" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РеквизитДС, "Владелец", Объект.Ссылка, Истина);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СЭ_СоздатьЭлементыФормы()
	
	//СЭ+ Евгений [16920]
	
	//Номером договора (генерируется при записи если не ручной ввод)		
	нЭлемент = Элементы.Вставить("СЭ_РучнойВводНомераДоговора", Тип("ПолеФормы"), Элементы.ГруппаНомерДата); 
	нЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	нЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	нЭлемент.ПутьКДанным = "Объект.СЭ_РучнойВводНомераДоговора";
    нЭлемент.УстановитьДействие("ПриИзменении", "СЭ_РучнойВводНомераДоговораПриИзменении");
	
	#Область Прочие_Реквизиты
	
	//Группа Прочие реквизиты
	нГруппа = Элементы.Добавить("СЭ_ГруппаПрочиеРеквизиты", Тип("ГруппаФормы"), Элементы.СтраницаОсновное);
	нГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	нГруппа.Заголовок = "";
	нГруппа.ОтображатьЗаголовок = Ложь;
	нГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	нГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	//ДатаВозвратаДоговора
	нЭлемент = Элементы.Вставить("СЭ_ДатаВозвратаДоговора", Тип("ПолеФормы"), Элементы.СЭ_ГруппаПрочиеРеквизиты); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_ДатаВозвратаДоговора";
	
	//Сроки
	нГруппа = Элементы.Добавить("СЭ_ГруппаПрочиеРеквизитыСроки", Тип("ГруппаФормы"), Элементы.СЭ_ГруппаПрочиеРеквизиты);
	нГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	нГруппа.Заголовок = "";
	нГруппа.ОтображатьЗаголовок = Ложь;
	нГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	нГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;

	нЭлемент = Элементы.Вставить("СЭ_СрокНаправленияСпециалистаСМоментаПолученияЗаявки", Тип("ПолеФормы"), Элементы.СЭ_ГруппаПрочиеРеквизитыСроки); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_СрокНаправленияСпециалистаСМоментаПолученияЗаявки";

	нЭлемент = Элементы.Вставить("СЭ_СрокВыполнениРемонтаСМоментаПолученияЗаявки", Тип("ПолеФормы"), Элементы.СЭ_ГруппаПрочиеРеквизитыСроки); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_СрокВыполнениРемонтаСМоментаПолученияЗаявки";
	
	нЭлемент = Элементы.Вставить("СЭ_СрокГарантииНаВыполненныеРаботы", Тип("ПолеФормы"), Элементы.СЭ_ГруппаПрочиеРеквизитыСроки); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_СрокГарантииНаВыполненныеРаботы";

	нЭлемент = Элементы.Вставить("СЭ_СрокГарантииНаУстановленныЗЧ", Тип("ПолеФормы"), Элементы.СЭ_ГруппаПрочиеРеквизитыСроки); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_СрокГарантииНаУстановленныЗЧ";

	#КонецОбласти
	
	#Область ТипДоговора_Реквизиты 
	
	//Группа Тип Договора
	нГруппа = Элементы.Вставить("СЭ_ГруппаТипДоговора", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево, Элементы.Наименование);
	нГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	нГруппа.Заголовок = "";
	нГруппа.ОтображатьЗаголовок = Ложь;
	нГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	нГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	//Тип договора
	нЭлемент = Элементы.Вставить("СЭ_ТипДоговора", Тип("ПолеФормы"), Элементы.СЭ_ГруппаТипДоговора); 
	нЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	нЭлемент.ПутьКДанным = "Объект.СЭ_ТипДоговора";
	нЭлемент.УстановитьДействие("ПриИзменении", "СЭ_ТипДоговораПриИзменении");
	
