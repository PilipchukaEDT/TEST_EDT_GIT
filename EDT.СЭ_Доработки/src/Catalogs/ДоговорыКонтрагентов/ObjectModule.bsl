Процедура СЭ_СгенерироватьНомерДоговораДрайв()
	
	//Если перезаписываем старый договор у которого уже сгенерирован номер, не пытаемся генерировать его снова
	Если ЗначениеЗаполнено(Ссылка) И НЕ Ссылка.СЭ_РучнойВводНомераДоговора И ЗначениеЗаполнено(Ссылка.Номер) Тогда
		Возврат;
	КонецЕсли;
	
	СЭ_ЧислоНомераДоговора 	= 0;
	СЭ_ГодНомераДоговора 	= 0;

	Если ТипДоговора = ПредопределенноеЗначение("Перечисление.ТипыДоговоров.СПокупателем") И НЕ СЭ_РучнойВводНомераДоговора Тогда
		
		ГодИзКонстанты = СЭ_ОбщегоНазначенияВызовСервераПривилегированный.ПолучитьЗначениеКонстанты("СЭ_ГодДляНумератораДоговора");
		Если ГодИзКонстанты <> Неопределено И ЗначениеЗаполнено(ГодИзКонстанты) Тогда
			СЭ_ГодНомераДоговора = Год(ГодИзКонстанты);	
		Иначе
			СЭ_ГодНомераДоговора = Год(ТекущаяДата());
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МАКСИМУМ(ДоговорыКонтрагентов.СЭ_ЧислоНомераДоговора) КАК СЭ_ЧислоНомераДоговора,
			|	ДоговорыКонтрагентов.СЭ_ТипДоговора КАК СЭ_ТипДоговора
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|ГДЕ
			|	ДоговорыКонтрагентов.СЭ_РучнойВводНомераДоговора = ЛОЖЬ
			|	И ДоговорыКонтрагентов.СЭ_ТипДоговора = &СЭ_ТипДоговора
			|	И ДоговорыКонтрагентов.СЭ_ГодНомераДоговора = &СЭ_ГодНомераДоговора
			|
			|СГРУППИРОВАТЬ ПО
			|	ДоговорыКонтрагентов.СЭ_ТипДоговора";
		
		Запрос.УстановитьПараметр("СЭ_ТипДоговора", СЭ_ТипДоговора);
		Запрос.УстановитьПараметр("СЭ_ГодНомераДоговора", СЭ_ГодНомераДоговора);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			СЭ_ЧислоНомераДоговора 	= 1;
		Иначе
				
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				СЭ_ЧислоНомераДоговора 	= Выборка.СЭ_ЧислоНомераДоговора + 1;
			КонецЦикла;
			
		КонецЕсли;
		
		Номер = СтрШаблон("%1%2/%3", Формат(СЭ_ЧислоНомераДоговора, "ЧГ=0"), СокрЛП(СЭ_ТипДоговора.КраткоеНаименование), Формат(СЭ_ГодНомераДоговора, "ЧГ=0")); 	
			
	КонецЕсли;
	

КонецПроцедуры
